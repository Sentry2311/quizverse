{
  "info": { "name": "QuizVerse REST API", "description": "CRUD and validation requests for the Experiment 4 REST API.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3001" }, { "key": "quizId", "value": "1" }, { "key": "createdQuizId", "value": "" }],
  "item": [
    { "name": "GET all quizzes", "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns 200 and an array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array') })"] } }] },
    { "name": "GET quiz by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes/{{quizId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns quiz', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('id') })"] } }] },
    { "name": "POST create quiz", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"API Basics\",\n  \"category\": \"Programming\",\n  \"minutes\": 5,\n  \"questions\": []\n}" }, "url": "{{baseUrl}}/api/quizzes" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('created with 201', () => { pm.response.to.have.status(201); pm.collectionVariables.set('createdQuizId', pm.response.json().id) })"] } }] },
    { "name": "PUT update created quiz", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"API Basics Updated\",\n  \"category\": \"Programming\",\n  \"minutes\": 6,\n  \"questions\": []\n}" }, "url": "{{baseUrl}}/api/quizzes/{{createdQuizId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('updated with 200', () => pm.response.to.have.status(200))"] } }] },
    { "name": "DELETE created quiz", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/quizzes/{{createdQuizId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('deleted with 200', () => pm.response.to.have.status(200))"] } }] },
    { "name": "Invalid request - missing fields", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"\"\n}" }, "url": "{{baseUrl}}/api/quizzes" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('validation error with 400', () => { pm.response.to.have.status(400); pm.expect(pm.response.json()).to.have.property('error') })"] } }] },
    { "name": "Invalid request - unknown ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/quizzes/999999" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('not found with 404', () => pm.response.to.have.status(404))"] } }] }
  ]
}
